# Dependencies and build output
node_modules/
dist/
coverage/
.expo/
web-build/

# Generated native projects (expo prebuild) — never committed
android/
ios/
# ...except the app's own native modules (4.14), which are source.
!apps/pocket/modules/*/android/
!apps/pocket/modules/*/ios/
apps/pocket/modules/*/android/build/
apps/pocket/modules/*/android/.gradle/

# Signing keys and store credentials — never committed, anywhere
*.jks
*.keystore
*.p12
*.p8
*.pem
*.key
google-services.json
GoogleService-Info.plist
.env
.env.*

# Design material lives only on the owner's machine
docs-private/
prototype/

# Local export output
dist-*/
test-results/
playwright-report/
