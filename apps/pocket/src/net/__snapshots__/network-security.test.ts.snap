exports[`the network security config (config plugin) the release build: no plain http; certificates installed by hand trusted, as its switch says 1`] = `
"<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <base-config cleartextTrafficPermitted="false">
    <trust-anchors>
      <certificates src="system"/>
      <certificates src="user"/>
    </trust-anchors>
  </base-config>
</network-security-config>
"
`;
