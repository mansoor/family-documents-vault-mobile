exports[`the network security config (config plugin) the preview build keeps plain http and certificates installed by hand 1`] = `
"<?xml version="1.0" encoding="utf-8"?>
<network-security-config>
  <base-config cleartextTrafficPermitted="true">
    <trust-anchors>
